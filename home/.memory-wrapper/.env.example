# Copy to ~/.memory-wrapper/.env and customize.
# This file is NOT committed with real secrets.

# Agentmemory
AGENTMEMORY_SECRET=change-me
AGENTMEMORY_PORT=3111
AGENTMEMORY_TOOLS=all
EMBEDDING_PROVIDER=local
III_BIND=0.0.0.0

# Peers
PEER_PC2_IP=
PEER_PC2_LABEL=pc2
# PEER_PC3_IP=
# PEER_PC3_LABEL=pc3

# Sync behavior
SYNC_ON_BOOT=true
SYNC_CRON_ENABLED=false
SYNC_CRON_INTERVAL=15

# Paths
WRAPPER_DIR="$HOME/.memory-wrapper"
JCODE_BIN="$HOME/.jcode/builds/stable/jcode"
