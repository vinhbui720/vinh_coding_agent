#!/usr/bin/env bash
# Start agentmemory server and perform optional boot sync.
set -euo pipefail

# Load nvm into current shell so npx is available
if [ -n "${NVM_DIR:-}" ] && [ -s "$NVM_DIR/nvm.sh" ]; then
  . "$NVM_DIR/nvm.sh"
elif [ -s "$HOME/.nvm/nvm.sh" ]; then
  export NVM_DIR="$HOME/.nvm"
  . "$NVM_DIR/nvm.sh"
fi

set -a
source "$HOME/.memory-wrapper/.env"
set +a
"$WRAPPER_DIR/bin/seed-agentmemory-state" >/dev/null 2>&1 || true

BOOT_FLAG="$WRAPPER_DIR/flags/boot-sync-done"
LOG="$WRAPPER_DIR/logs/agentmemory.log"
PID_FILE="$WRAPPER_DIR/flags/agentmemory.pid"

mkdir -p "$WRAPPER_DIR/flags" "$WRAPPER_DIR/logs"

if [ -f "$PID_FILE" ]; then
  OLD_PID=$(cat "$PID_FILE")
  if kill -0 "$OLD_PID" 2>/dev/null; then
    echo "[agentmemory-start] Server already running (PID $OLD_PID)"
    exit 0
  fi
fi

rm -f "$BOOT_FLAG"

export AGENTMEMORY_URL="http://localhost:${AGENTMEMORY_PORT:-3111}"
export AGENTMEMORY_III_VERSION="${AGENTMEMORY_III_VERSION:-0.11.2}"

echo "[$(date)] Starting agentmemory server..." >> "$LOG"
if command -v agentmemory >/dev/null 2>&1; then
  nohup agentmemory --tools "${AGENTMEMORY_TOOLS:-all}" --verbose >> "$LOG" 2>&1 &
else
  nohup npx -y @agentmemory/agentmemory --tools "${AGENTMEMORY_TOOLS:-all}" --verbose >> "$LOG" 2>&1 &
fi
echo $! > "$PID_FILE"
echo "[agentmemory-start] Server started (PID $(cat "$PID_FILE"))"

for i in {1..45}; do
  if curl -fsS --max-time 2 -H "Authorization: Bearer $AGENTMEMORY_SECRET" "http://localhost:${AGENTMEMORY_PORT:-3111}/agentmemory/health" >/dev/null 2>&1; then
    echo "[agentmemory-start] Server ready after ${i}s"
    break
  fi
  sleep 1
done

if [ "${SYNC_ON_BOOT:-false}" = "true" ] && [ ! -f "$BOOT_FLAG" ]; then
  "$WRAPPER_DIR/bin/sync-memory" --boot || true
fi
