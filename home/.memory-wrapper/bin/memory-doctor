#!/usr/bin/env bash
# Diagnose and optionally repair common Jcode <-> agentmemory integration issues.
set -euo pipefail

FIX=false
if [ "${1:-}" = "--fix" ]; then
  FIX=true
fi

ENV_FILE="$HOME/.memory-wrapper/.env"
if [ ! -f "$ENV_FILE" ]; then
  echo "FAIL: missing $ENV_FILE"
  exit 1
fi

set -a
source "$ENV_FILE"
set +a

ok() { echo "OK   $*"; }
warn() { echo "WARN $*"; }
fail() { echo "FAIL $*"; }

# 1) symlink sanity
if [ -L "$HOME/.jcode/mcp.json" ]; then ok "~/.jcode/mcp.json is symlinked"; else warn "~/.jcode/mcp.json not symlinked"; fi
if [ -L "$HOME/.memory-wrapper" ]; then ok "~/.memory-wrapper is symlinked"; else warn "~/.memory-wrapper not symlinked"; fi

# 2) process health
if curl -fsS --max-time 3 -H "Authorization: Bearer $AGENTMEMORY_SECRET" "http://localhost:${AGENTMEMORY_PORT:-3111}/agentmemory/health" >/dev/null; then
  ok "agentmemory health endpoint reachable"
else
  warn "agentmemory health endpoint not reachable"
  if $FIX; then
    echo "Attempting restart..."
    "$HOME/.memory-wrapper/bin/restart-agentmemory" || true
  fi
fi

# 3) mcp wrapper callable
if "$HOME/.memory-wrapper/bin/agentmemory-status" >/dev/null 2>&1; then
  ok "agentmemory-status OK"
else
  warn "agentmemory-status failed"
fi

# 4) feature checks
stats=$($HOME/.memory-wrapper/bin/graph-stats 2>/dev/null || true)
if echo "$stats" | grep -q "Total nodes"; then
  ok "graph-stats works"
else
  warn "graph-stats failed"
fi

echo "\nRecommended commands:"
echo "  ~/.memory-wrapper/bin/agentmemory-status"
echo "  ~/.memory-wrapper/bin/memory-search \"<query>\" 5"
echo "  ~/.memory-wrapper/bin/memory-save-and-extract decision \"<title>\" \"<content>\""
echo "  ~/.memory-wrapper/bin/graph-query \"<query>\" 10"
echo "  ~/.memory-wrapper/bin/crystallize \"<title>\" \"<content>\" \"tag1,tag2\""
