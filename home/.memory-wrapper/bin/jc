#!/usr/bin/env bash
# Wrapper for jcode that records transcript for long-term memory.
set -euo pipefail
source "$HOME/.memory-wrapper/.env"

TRANSCRIPT=$(mktemp /tmp/jcode-session-XXXXXX.txt)
cleanup() {
  if [ -s "$TRANSCRIPT" ]; then
    "$WRAPPER_DIR/bin/post-session" "$TRANSCRIPT" &
  fi
  rm -f "$TRANSCRIPT"
}
trap cleanup EXIT

# When stdout is a TTY, jcode's TUI requires it — run directly without a pipe.
# Transcript capture only works in non-TTY contexts (scripting, piped usage).
if [ -t 1 ]; then
  exec "$JCODE_BIN" "$@"
else
  "$JCODE_BIN" "$@" 2>&1 | tee "$TRANSCRIPT"
fi
